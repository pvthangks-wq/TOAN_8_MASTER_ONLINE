# Dành cho docker-compose với tên miền đã trỏ về máy chủ.
DOMAIN=toan8.example.edu.vn
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Chỉ khi muốn khởi tạo tài khoản quản trị qua /setup trên VPS:
# BOOTSTRAP_TOKEN=chuoi_bi_mat_ngau_nhien_it_nhat_32_ky_tu
# Sau khi khởi tạo tài khoản, xóa biến BOOTSTRAP_TOKEN.
# Nếu chạy Python trực tiếp, khai báo:
# DB_PATH=./instance/toan8.db
# COOKIE_SECURE=0
# Ở môi trường sản xuất có HTTPS, COOKIE_SECURE=1.
